{
  "parseCases": [
    {
      "name": "word alias",
      "source": "times",
      "expected": {
        "ok": true,
        "value": [{ "kind": "operator", "value": "×" }]
      }
    },
    {
      "name": "longest punctuation aliases",
      "source": "a /_\\ b // c ^^ d",
      "expected": {
        "ok": true,
        "value": [
          { "kind": "identifier", "value": "a" },
          { "kind": "operator", "value": "△" },
          { "kind": "identifier", "value": "b" },
          { "kind": "operator", "value": "/" },
          { "kind": "identifier", "value": "c" },
          { "kind": "operator", "value": "∧" },
          { "kind": "identifier", "value": "d" }
        ]
      }
    },
    {
      "name": "alias prefixes stay inside words",
      "source": "ooops oxygen xxValue !index",
      "expected": {
        "ok": true,
        "value": [
          { "kind": "identifier", "value": "ooops" },
          { "kind": "identifier", "value": "oxygen" },
          { "kind": "identifier", "value": "xxValue" },
          { "kind": "text", "value": "!" },
          { "kind": "identifier", "value": "index" }
        ]
      }
    },
    {
      "name": "named backslash and Unicode aliases",
      "source": "alpha \\alpha α",
      "expected": {
        "ok": true,
        "value": [
          { "kind": "identifier", "value": "α" },
          { "kind": "identifier", "value": "α" },
          { "kind": "identifier", "value": "α" }
        ]
      }
    },
    {
      "name": "supplementary Unicode scalar",
      "source": "𝛽",
      "expected": {
        "ok": true,
        "value": [{ "kind": "identifier", "value": "𝛽" }]
      }
    },
    {
      "name": "direct Greek variant bases",
      "source": "ϴ ϵ ϰ ϱ ϖ",
      "expected": {
        "ok": true,
        "value": [
          { "kind": "identifier", "value": "ϴ" },
          { "kind": "identifier", "value": "ϵ" },
          { "kind": "identifier", "value": "ϰ" },
          { "kind": "identifier", "value": "ϱ" },
          { "kind": "identifier", "value": "ϖ" }
        ]
      }
    },
    {
      "name": "script with transparent group",
      "source": "A_{rect}",
      "expected": {
        "ok": true,
        "value": [
          {
            "kind": "subscript",
            "base": { "kind": "identifier", "value": "A" },
            "subscript": {
              "kind": "group",
              "fence": "none",
              "body": [{ "kind": "identifier", "value": "rect" }]
            }
          }
        ]
      }
    },
    {
      "name": "isolated surrogate",
      "source": "\ud800",
      "expected": { "ok": false, "code": "INVALID_UNICODE", "offset": 0 }
    },
    {
      "name": "unmatched curly closer",
      "source": "A}",
      "expected": {
        "ok": false,
        "code": "UNEXPECTED_CLOSING_GROUP",
        "offset": 1
      }
    },
    {
      "name": "unmatched round closer",
      "source": "A)",
      "expected": {
        "ok": false,
        "code": "UNEXPECTED_CLOSING_GROUP",
        "offset": 1
      }
    },
    {
      "name": "unmatched square closer",
      "source": "A]",
      "expected": {
        "ok": false,
        "code": "UNEXPECTED_CLOSING_GROUP",
        "offset": 1
      }
    },
    {
      "name": "unmatched fraction denominator closer",
      "source": "a/]",
      "expected": {
        "ok": false,
        "code": "UNEXPECTED_CLOSING_GROUP",
        "offset": 2
      }
    },
    {
      "name": "missing fraction denominator",
      "source": "a/",
      "expected": {
        "ok": false,
        "code": "MISSING_FRACTION_DENOMINATOR",
        "offset": 2
      }
    },
    {
      "name": "mismatched group closer",
      "source": "{a]}",
      "expected": {
        "ok": false,
        "code": "UNEXPECTED_CLOSING_GROUP",
        "offset": 2
      }
    },
    {
      "name": "scalar offset after supplementary Unicode",
      "source": "𝛼{missing",
      "expected": { "ok": false, "code": "UNCLOSED_GROUP", "offset": 1 }
    }
  ],
