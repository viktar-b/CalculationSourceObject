{
  "name": "@viktar-b/cso-core",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "description": "CalculationSourceObject validation, conversion and code generation.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES.txt"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "vitest run --config vitest.config.ts",
    "prepack": "npm run build",
    "lint": "biome lint src tests",
    "pretest": "npm run build"
  },
  "overrides": {
    "esbuild": "0.28.2"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5",
    "vitest": "^5.0.0",
    "@types/node": "^24",
    "@biomejs/biome": "1.9.4"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "zod": "^4.6.2"
  }
}
