{
  "name": "@viktar-b/cso-react",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "description": "CalculationSourceObject React rendering, mathematical notation and printing.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json",
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES.txt"
  ],
  "sideEffects": [
    "./dist/style.css"
  ],
  "scripts": {
    "build": "tsup && npm run build:css",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "vitest run --config vitest.config.ts",
    "prepack": "npm run build",
    "build:css": "tailwindcss -i src/styles.css -o dist/style.css --minify",
    "lint": "biome lint src tests",
    "pretest": "npm run build"
  },
  "devDependencies": {
    "typescript": "^5",
    "tsup": "^8.5.1",
    "vitest": "^4.1.11",
    "react": "^18.3.1",
    "@types/react": "^18",
    "tailwindcss": "^3.4.17",
    "@types/node": "^20",
    "@biomejs/biome": "1.9.4",
    "react-dom": "^18.3.1",
    "@types/react-dom": "^18"
  },
  "dependencies": {
    "@viktar-b/cso-core": "0.1.0"
  },
  "peerDependencies": {
    "react": ">=18.3.0"
  }
}
