{
  "name": "@cs-object/cli",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "type": "module",
  "description": "Installed calculation verification and development export/render commands.",
  "bin": {
    "cso": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/development.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsup",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit --pretty false",
    "lint": "biome lint src tests",
    "test": "vitest run --config vitest.config.ts",
    "pretest": "npm run build"
  },
  "dependencies": {
    "@cs-object/core": "1.0.0",
    "@cs-object/react": "1.0.0",
    "playwright": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "overrides": {
    "esbuild": "0.28.2"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5",
    "vitest": "^5.0.5",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@biomejs/biome": "2.6.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/viktar-b/CalculationSourceObject.git",
    "directory": "packages/cso-cli"
  },
  "homepage": "https://github.com/viktar-b/CalculationSourceObject#readme",
  "bugs": {
    "url": "https://github.com/viktar-b/CalculationSourceObject/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
