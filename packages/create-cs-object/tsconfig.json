{
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "template/scripts/**/*.ts",
    "tsup.config.ts"
  ],
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2023"
  }
}
